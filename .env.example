# =============================================================================
# Injaazh ERP OS - Environment Configuration Template
# Copy this file to .env.local for local development.
# =============================================================================

# Primary Database Connection (Authoritative Target: injaazh_os)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/injaazh_os?retryWrites=true&w=majority"

# Authentication & Session Security (Required: minimum 32-character random string)
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"

# Optional: Dedicated Encryption Key for System Settings (defaults to JWT_SECRET if omitted)
# ENCRYPTION_KEY="replace-with-a-secure-32-character-encryption-key"

# Canonical Application URLs (used for CORS origin validation and email reset links)
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# AI Copilot Integration (Optional)
# GEMINI_API_KEY="your-google-gemini-api-key"

# File Upload Configuration (Optional, defaults to 10485760 / 10MB)
# MAX_UPLOAD_SIZE=10485760

# Transactional Email / SMTP Settings (Optional, can also be configured via Settings UI)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="mailer@example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="Injaazh ERP <mailer@example.com>"
